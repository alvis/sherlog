{
  "name": "sherlog",
  "version": "1.0.0",
  "description": "Beautiful error rendering — colorized stack traces with source code display.",
  "keywords": [
    "error",
    "render",
    "stack",
    "trace",
    "source",
    "highlight",
    "colorize",
    "chalk"
  ],
  "homepage": "https://github.com/alvis/sherlog#readme",
  "bugs": {
    "url": "https://github.com/alvis/sherlog/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvis/sherlog.git"
  },
  "license": "MIT",
  "author": {
    "name": "Alvis HT Tang",
    "email": "alvis@hilbert.space"
  },
  "type": "module",
  "imports": {
    "#content": {
      "browser": "./src/content.browser.ts",
      "default": "./src/content.node.ts"
    },
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "run build",
    "lint": "run lint --",
    "prepare": "run prepare",
    "prepublishOnly": "run prepublishOnly",
    "release": "run release --",
    "test": "run test --",
    "test:coverage": "run test:coverage --",
    "test:watch": "run test:watch --"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.0",
    "chalk": "^6.0.0",
    "js-tokens": "^10.0.0",
    "xception": "^9.1.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "xception": "^9.0.0"
  },
  "devDependencies": {
    "@presetter/preset-esm": "^9.1.0",
    "@presetter/preset-strict": "^9.1.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "presetter": "^9.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "imports": {
      "#content": {
        "browser": "./lib/content.browser.js",
        "default": "./lib/content.node.js"
      },
      "#*": "./lib/*.js"
    }
  }
}
